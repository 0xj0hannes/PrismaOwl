# ---------------------------------------------------------------------------
# LLM provider. Two options, both OpenAI-compatible:
#   orcarouter  (default) - one key, routes across 100+ models
#   gemini                - Google Gemini Developer API directly (free tier)
# Leave LLM_PROVIDER empty to auto-detect from whichever key is set below
# (OrcaRouter wins if both are set).
# ---------------------------------------------------------------------------
LLM_PROVIDER=

# Option A: OrcaRouter. Get a key at https://www.orcarouter.ai (console -> API
# keys) and add credits ("orcarouter/free" works without credits).
ORCA_API_KEY=sk-orca-your_key_here
# ORCA_BASE_URL=https://api.orcarouter.ai/v1

# Option B: Google Gemini. Get a key at https://aistudio.google.com/ (no credit
# card needed). Uses Gemini's OpenAI-compatible endpoint; no SDK required.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Default model for every LLM task. Leave empty for the provider default:
#   orcarouter -> "orcarouter/auto" (adaptive routing; strategy set in the
#                 OrcaRouter console). "orcarouter/free" = free models only.
#   gemini     -> "gemini-3.5-flash"
# Run `python3 test_llm.py` to list every id your key can use.
MODEL_NAME=

# Per-task overrides (leave empty to use MODEL_NAME):
#   screening = title/abstract screening. REPRODUCIBILITY RULE: with OrcaRouter
#               this must be ONE concrete "vendor/model" id (e.g.
#               anthropic/claude-sonnet-5, google/gemini-3.5-flash). Meta-models
#               such as orcarouter/auto, orcarouter/free or orcarouter/fusion-*
#               route each request to a different upstream and are refused for
#               screening. Without credits, use a free concrete id such as
#               deepseek/deepseek-v4-flash-free (listed by test_llm.py --models).
#               Every result stores the model that judged it, the
#               router's answer is checked against the pin, and a batch will
#               not start if earlier results came from a different model.
#   query     = search-strategy builder (meta-models fine)
#   criteria  = inclusion-criteria assistant (meta-models fine)
#   chat      = chatbot over the included records (needs a large context window)
MODEL_SCREENING=anthropic/claude-sonnet-5
MODEL_QUERY=
MODEL_CRITERIA=
MODEL_CHAT=

# Retries for non-transient LLM errors (bad JSON etc.) per record
MAX_RETRIES=3
# Seconds to wait for a single LLM response (reasoning models can be slow on
# the big search-strategy prompt; raise this if you see read timeouts)
LLM_TIMEOUT=300

# How strictly screening decides Include / Exclude / Maybe (also set on the
# Screening tab): strict = precision first, Maybe is rare; balanced = every
# unclear abstract becomes Maybe; lenient = recall first, Exclude only clearly
# off-topic papers. Recorded on every result; one review must not mix levels.
SCREENING_STRICTNESS=strict

# ---------------------------------------------------------------------------
# Literature-database harvesting (main.py harvest / web "Search Strategy" tab)
# OpenAlex, arXiv and Crossref need no key. The rest are optional.
# ---------------------------------------------------------------------------
# Your e-mail: unlocks OpenAlex/Crossref "polite pool" (faster, more reliable)
OPENALEX_EMAIL=
# https://www.semanticscholar.org/product/api  (optional, raises rate limits)
SEMANTIC_SCHOLAR_API_KEY=
# https://dev.elsevier.com  (Scopus; abstracts need an institutional token or campus IP)
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
# https://developer.ieee.org
IEEE_API_KEY=
